# Supabase — safe to commit (no secrets)
# Copy this file to .env.local and fill in your values from the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# In Supabase → Project Settings → API, copy the "Publishable key" (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# NEVER put the Secret key (sb_secret_...) in the frontend or in NEXT_PUBLIC_ variables.
# Secret keys bypass Row Level Security and must only be used server-side.

# Groq — free Wellness Assistant (server-side only, no credit card required)
# Sign up at https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here
